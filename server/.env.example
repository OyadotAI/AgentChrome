PORT=3100
# Valid API keys for self-hosting without a database. These are ordinary keys:
# env grants a key existence, never authority. Every key is its own tenant and
# sees only its own browsers, providers, sessions, usage and audit trail.
API_KEYS=key1,key2

# Host-level controls that are not tenant data: the Prometheus scrape at
# /metrics, POST /api/operator/drain, and POST /api/fleet/provision (minting
# credentials). No API key can do these. Generate with: openssl rand -hex 32
# OYA_OPERATOR_TOKEN=

# Supabase — persistent key storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Fleet mode — set a single token that all browsers can use to auto-enroll.
# Every browser configured with this token as its API key will be accepted.
# FLEET_TOKEN=my-shared-secret

# Chat mode (optional)
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-5.4
CHAT_MAX_ITERATIONS=200

# Cloud browsers — POST /browsers/provision launches sandboxed browsers that
# enroll over the normal WebSocket. All three are required to enable it.
# DAYTONA_API_KEY=dtn_...
# DAYTONA_SNAPSHOT=oya-browser
# OYA_PUBLIC_WS_URL=wss://your-server.example.com/ws
# Optional
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# Idle stop / TTL for a provisioned sandbox, in minutes (default 60).
# DAYTONA_SANDBOX_TTL_MINUTES=60

# ── CDP gateway ──
# Point Playwright, Puppeteer, Stagehand or browser-use at
# ws://host/connect?token=<api key> — discovery lives at /json/version.
# Providers the gateway routes to, as JSON:
#   [{"name":"local","type":"cdp","wsUrl":"ws://127.0.0.1:9222/devtools/browser/…",
#     "maxConcurrent":10,"priority":1}]
# type may also name a hosted provider (anchor, browserbase, steel), in which
# case its own API key below is used to open a session per connection.
# OYA_PROVIDERS=[]
# priority | round-robin | least-connections | latency | weighted
# OYA_ROUTING_STRATEGY=priority
# Each API key may override this for its own sessions from the dashboard.

# The host dials provider URLs that callers supply, so private and loopback
# addresses are refused by default — that is a server-side request forgery
# primitive on a shared deployment. Turn this on ONLY where every API key is
# yours, e.g. a laptop pointing at ws://127.0.0.1:9222. Link-local (cloud
# metadata) stays blocked either way.
# OYA_ALLOW_PRIVATE_TARGETS=false
# How long a session is held for a dropped client to resume against (ms).
# OYA_SESSION_GRACE_MS=60000

# Hosted CDP providers (optional)
# ANCHOR_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# STEEL_API_KEY=
# Override a provider's endpoint/auth/response shape without a code change:
# OYA_BROWSER_PROVIDERS={"anchor":{"createUrl":"…","wsPath":["data.cdp_url"]}}

# ── Persistent profiles ──
# Required to store profiles. Generate with: openssl rand -hex 32
# OYA_PROFILE_SECRET=

# ── Session recording (opt-in per session with ?record=1) ──
# OYA_RECORD_MAX_FRAMES=1800
# OYA_RECORD_MAX_BYTES=104857600
# OYA_RECORD_QUALITY=40
# OYA_RECORD_EVERY_NTH=5

# ── Observability ──
# Lets a Prometheus scraper read /metrics without an admin key.
# OYA_METRICS_TOKEN=
# All server state (cookies, config, profiles, recordings, usage, audit).
# OYA_DATA_DIR=

# ── Rate limits (per API key; 0 disables) ──
# OYA_LIMIT_COMMANDS_PER_MIN=600
# OYA_LIMIT_COMMANDS_BURST=120
# OYA_LIMIT_CHAT_PER_MIN=60
# OYA_LIMIT_PROVISION_PER_MIN=20
# OYA_LIMIT_CONNECT_PER_MIN=120

# ── Quotas (0 disables) ──
# OYA_QUOTA_MAX_BROWSERS=5000
# OYA_QUOTA_CHAT_TOKENS_HOUR=2000000
# OYA_QUOTA_SANDBOXES_HOUR=500

# ── Personas ──
# A persona is one identity: fingerprint + cookie jar + proxy, bound together
# and stable. Rotation means picking a different persona, never giving one a
# new fingerprint.
# Concurrency cap for a named persona — one device, so a low number. A person
# has a phone and a laptop; a thousand simultaneous sessions from one device
# fingerprint is a signal no amount of stealth hides.
# OYA_PERSONA_MAX_CONCURRENT=2
# The per-key default persona is uncapped, so keys already running many
# browsers keep working. Set this to cap them too.
# OYA_DEFAULT_PERSONA_MAX_CONCURRENT=
